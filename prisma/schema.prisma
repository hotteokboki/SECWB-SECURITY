  timestamp                DateTime?           @default(now()) @db.Timestamp(6)
  consent                  Boolean?
  team_name                String?
  enterprise_idea_start    String?
  involved_people          String?
  current_phase            String?
  se_nature                String?
  team_characteristics     String?
  critical_areas           String[]
  action_plans             String?
  meeting_frequency        String?
  communication_modes      String[]
  social_media_link        String?
  focal_person_contact     String?
  mentoring_team_members   String?
  preferred_mentoring_time String[]
  mentoring_time_note      String?
  pitch_deck_url           String?
  se_abbreviation          String?
  focal_email              String?
  focal_phone              String?
  status                   String?             @default("Pending")
  se_description           String?
  social_problem           String[]
  team_challenges          String[]
  socialenterprises        socialenterprises[]
}

model mentor_evaluation_questions {
  category      String @db.VarChar(255)
  question_text String
  id            String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model mentor_form_application {
  serial_number      Int       @id @default(autoincrement())
  id                 String?   @unique @default(dbgenerated("('MENTOR-'::text || lpad((serial_number)::text, 4, '0'::text))"))
  first_name         String
  last_name          String
  email              String    @unique
  password           String
  affiliation        String
  motivation         String
  expertise          String
  business_areas     String[]
