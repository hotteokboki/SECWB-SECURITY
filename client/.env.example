# LSEED Insight — frontend (Vite) environment variables
#
# Copy to client/.env.development or client/.env.production and fill in.
# NEVER commit a filled-in copy — both are already gitignored.
#
# IMPORTANT: only variables prefixed VITE_ are exposed to the browser bundle.
# Never put a secret here — anything in this file ships to every visitor's
# browser. There are currently no secrets in the frontend config, and it
# should stay that way.

# Used only by vite.config.js as the dev-server proxy target for /api, /auth,
# /login, /signup, etc. Not read anywhere in browser runtime code.
# Development: point at your local backend.
# Production: leave empty — the frontend and backend are served from the
#   same origin in production (Express serves the built SPA), so API calls
#   are relative and need no base URL.
VITE_API_URL=http://localhost:4000
