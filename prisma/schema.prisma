/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model mentoring_session {
  mentoring_session_id   String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  mentorship_id          String      @db.Uuid
  start_time             DateTime    @db.Timestamp(6)
  end_time               DateTime    @db.Timestamp(6)
  zoom_link              String?
  status                 String?     @default("No Schedule Yet") @db.VarChar(20)
  mentoring_session_date DateTime    @db.Date
