}

model mentors {
  mentor_id                         String                              @id(map: "Mentors_pkey") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  mentor_firstname                  String?
  mentor_lastname                   String?
  number_SE_assigned                Int?                                @default(0)
  email                             String?
  contactnum                        String?
  isactive                          Boolean?                            @default(true)
  status                            String?                             @default("Active") @db.VarChar(20)
  critical_areas                    String[]
  is_available_for_assignment       Boolean?                            @default(true)
  preferred_mentoring_time          String[]
  accepted_application_id           String?                             @unique(map: "mentors_unique_application")
  evaluations                       evaluations[]
  mentor_form_application           mentor_form_application?            @relation(fields: [accepted_application_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_accepted_application")
  users                             users                               @relation(fields: [mentor_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "mentor_id")
  mentorship_collaboration_requests mentorship_collaboration_requests[]
  mentorships                       mentorships[]
  telegrambot                       telegrambot[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model mentorship_collaboration_requests {
  mentorship_collaboration_request_id     String                      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tier                                    Int
  seeking_collaboration_mentor_name       String
  seeking_collaboration_se_name           String
  seeking_collaboration_se_abbreviation   String
  suggested_collaboration_mentor_name     String
  suggested_collaboration_se_name         String
  suggested_collaboration_se_abbreviation String
  matched_categories                      String[]
  seeking_collaboration_se_strengths      String[]
  seeking_collaboration_se_weaknesses     String[]
  suggested_collaboration_se_strengths    String[]
  suggested_collaboration_se_weaknesses   String[]
  created_at                              DateTime                    @default(now()) @db.Timestamptz(6)
  suggested_collaboration_mentor_id       String                      @db.Uuid
  collaboration_card_id                   String
  subtier                                 Int?
  status                                  String                      @default("Pending")
  collaboration_tiers                     collaboration_tiers         @relation(fields: [tier], references: [tier_id], map: "fk_collaboration_tier")
  mentors                                 mentors                     @relation(fields: [suggested_collaboration_mentor_id], references: [mentor_id], map: "fk_suggested_mentor")
  mentorship_collaborations               mentorship_collaborations[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model mentorship_collaborations {
  collaboration_id                                                                        String                            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  seeking_collaboration_mentorship_id                                                     String                            @db.Uuid
  suggested_collaborator_mentorship_id                                                    String                            @db.Uuid
  tier_id                                                                                 Int                               @default(1)
  mentorship_collaboration_request_id                                                     String                            @db.Uuid
  status                                                                                  Boolean?                          @default(true)
  created_at                                                                              DateTime?                         @default(now()) @db.Timestamp(6)
  mentorship_collaboration_requests                                                       mentorship_collaboration_requests @relation(fields: [mentorship_collaboration_request_id], references: [mentorship_collaboration_request_id], map: "fk_collaboration_request")
  mentorships_mentorship_collaborations_seeking_collaboration_mentorship_idTomentorships  mentorships                       @relation("mentorship_collaborations_seeking_collaboration_mentorship_idTomentorships", fields: [seeking_collaboration_mentorship_id], references: [mentorship_id], onDelete: Cascade, map: "fk_seeking_collab_mentorship")
  mentorships_mentorship_collaborations_suggested_collaborator_mentorship_idTomentorships mentorships                       @relation("mentorship_collaborations_suggested_collaborator_mentorship_idTomentorships", fields: [suggested_collaborator_mentorship_id], references: [mentorship_id], onDelete: Cascade, map: "fk_suggested_collab_mentorship")
  collaboration_tiers                                                                     collaboration_tiers               @relation(fields: [tier_id], references: [tier_id], map: "fk_tier")

  @@unique([seeking_collaboration_mentorship_id, suggested_collaborator_mentorship_id, tier_id], map: "unique_directional_pair_per_tier")
}

model mentorships {
  mentorship_id                                                                                         String                      @id(map: "Mentorships_pkey") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  mentor_id                                                                                             String?                     @db.Uuid
  se_id                                                                                                 String?                     @db.Uuid
  status                                                                                                mentorship_status?          @default(Active)
  start_date                                                                                            DateTime?                   @default(dbgenerated("CURRENT_DATE")) @db.Date
  end_date                                                                                              DateTime?                   @db.Date
  feedback                                                                                              feedback[]
  mentoring_session                                                                                     mentoring_session[]
  mentorship_collaborations_mentorship_collaborations_seeking_collaboration_mentorship_idTomentorships  mentorship_collaborations[] @relation("mentorship_collaborations_seeking_collaboration_mentorship_idTomentorships")
  mentorship_collaborations_mentorship_collaborations_suggested_collaborator_mentorship_idTomentorships mentorship_collaborations[] @relation("mentorship_collaborations_suggested_collaborator_mentorship_idTomentorships")
  mentors                                                                                               mentors?                    @relation(fields: [mentor_id], references: [mentor_id], onDelete: NoAction, onUpdate: NoAction, map: "mentorships_mentor_fkey")
  socialenterprises                                                                                     socialenterprises?          @relation(fields: [se_id], references: [se_id], onDelete: NoAction, onUpdate: NoAction, map: "mentorships_se_fkey")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
