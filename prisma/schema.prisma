}

model sdg {
  sdg_id     String  @id(map: "SDG_pkey") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name       String?
  sdg_number Int?
}

model session {
  sid    String   @id @db.VarChar(255)
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)
}

model signup_passwords {
  id          Int      @id @default(autoincrement())
  password    String
  valid_from  DateTime @default(now()) @db.Timestamp(6)
  valid_until DateTime @db.Timestamp(6)
  created_at  DateTime @default(now()) @db.Timestamp(6)
}

model socialenterprises {
  se_id                    String                    @id(map: "SocialEnterprises_pkey") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  team_name                String?
  program_id               String                    @db.Uuid
  nummember                Int?
  sdg_id                   String[]                  @db.Uuid
  abbr                     String?
  created_at               DateTime?                 @default(dbgenerated("CURRENT_DATE")) @db.Date
  contactnum               String?
  isactive                 Boolean?                  @default(true)
  critical_areas           String[]                  @default([])
  description              String?
  preferred_mentoring_time String[]
  mentoring_time_note      String?
  accepted_application_id  String?
  cash_in_report           cash_in_report[]
  cash_out_report          cash_out_report[]
  evaluations              evaluations[]
  inventory_report         inventory_report[]
  mentorships              mentorships[]
  mentees_form_submissions mentees_form_submissions? @relation(fields: [accepted_application_id], references: [id], onUpdate: NoAction, map: "fk_accepted_application")
  programs                 programs                  @relation(fields: [program_id], references: [program_id], onDelete: NoAction, onUpdate: NoAction, map: "program_ID")
  telegrambot              telegrambot[]
}

model telegram_password {
