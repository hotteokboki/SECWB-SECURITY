generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model active_sessions {
  session_id String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id    String? @db.Uuid
  users      users?  @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model asset {
  asset_id             String                 @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  asset_name           String                 @unique
  asset_amount         Decimal                @db.Decimal(12, 2)
  cash_in_transaction  cash_in_transaction[]
  cash_out_transaction cash_out_transaction[]
}

model audit_logs {
  log_id     String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id    String?   @db.Uuid
  action     String
  details    Json?
  timestamp  DateTime? @default(now()) @db.Timestamptz(6)
  ip_address String?
  users      users?    @relation(fields: [user_id], references: [user_id], onUpdate: NoAction)

  @@index([timestamp(sort: Desc)], map: "idx_audit_logs_timestamp")
  @@index([user_id], map: "idx_audit_logs_user_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model bill_of_materials {
  bom_id             String  @db.Uuid
  record_id          String  @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  raw_material_name  String
  raw_material_price Decimal @db.Decimal(12, 2)
  raw_material_qty   Decimal @db.Decimal(12, 2)
  bom                bom     @relation(fields: [bom_id], references: [bom_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_bom_in_bomlines")

  @@id([bom_id, record_id])
}

model bom {
  bom_id            String              @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  bom_name          String              @unique
  bill_of_materials bill_of_materials[]
  item              item[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model cash_in_report {
  cash_in_report_id   String                @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  se_id               String                @db.Uuid
  report_month        DateTime              @db.Date
  socialenterprises   socialenterprises     @relation(fields: [se_id], references: [se_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_se_cash_in_rep")
  cash_in_transaction cash_in_transaction[]

  @@unique([se_id, report_month], map: "uq_cin_se_month")
  @@index([se_id, report_month], map: "idx_cin_report_se_month")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model cash_in_transaction {
  transaction_id        String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  cash_in_report_id     String         @db.Uuid
  transaction_date      DateTime       @db.Date
  cash_amount           Decimal        @default(0) @db.Decimal(12, 2)
  sales_amount          Decimal        @default(0) @db.Decimal(12, 2)
  other_revenue_amount  Decimal        @default(0) @db.Decimal(12, 2)
  asset_id              String?        @db.Uuid
  liability_amount      Decimal        @default(0) @db.Decimal(12, 2)
  owners_capital_amount Decimal        @default(0) @db.Decimal(12, 2)
  note                  String?
  entered_by            String?
  client_txn_key        String?        @unique(map: "uq_cin_client_key")
  asset                 asset?         @relation(fields: [asset_id], references: [asset_id], onUpdate: NoAction, map: "fk_asset_in_cin")
  cash_in_report        cash_in_report @relation(fields: [cash_in_report_id], references: [cash_in_report_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_cash_in_report")

  @@index([asset_id], map: "idx_cin_tx_asset")
  @@index([transaction_date], map: "idx_cin_tx_date")
  @@index([cash_in_report_id], map: "idx_cin_tx_report_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model cash_out_report {
  cash_out_report_id   String                 @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  se_id                String                 @db.Uuid
  report_month         DateTime               @db.Date
  socialenterprises    socialenterprises      @relation(fields: [se_id], references: [se_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_se_cash_out_rep")
  cash_out_transaction cash_out_transaction[]

  @@unique([se_id, report_month], map: "uq_cout_se_month")
  @@index([se_id, report_month], map: "idx_cout_report_se_month")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model cash_out_transaction {
  transaction_id           String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  cash_out_report_id       String          @db.Uuid
  transaction_date         DateTime        @db.Date
  cash_amount              Decimal         @default(0) @db.Decimal(12, 2)
  expense_id               String?         @db.Uuid
  asset_id                 String?         @db.Uuid
  inventory_amount         Decimal         @default(0) @db.Decimal(12, 2)
  liability_amount         Decimal         @default(0) @db.Decimal(12, 2)
  owners_withdrawal_amount Decimal         @default(0) @db.Decimal(12, 2)
  note                     String?
  entered_by               String?
  client_txn_key           String?         @unique(map: "uq_cout_client_key")
  asset                    asset?          @relation(fields: [asset_id], references: [asset_id], onUpdate: NoAction, map: "fk_asset_in_cout")
  cash_out_report          cash_out_report @relation(fields: [cash_out_report_id], references: [cash_out_report_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_cash_out_report")
  expense                  expense?        @relation(fields: [expense_id], references: [expense_id], onUpdate: NoAction, map: "fk_expense_in_cout")

  @@index([asset_id], map: "idx_cout_tx_asset")
  @@index([transaction_date], map: "idx_cout_tx_date")
  @@index([expense_id], map: "idx_cout_tx_expense")
  @@index([cash_out_report_id], map: "idx_cout_tx_report_id")
}

model collaboration_tiers {
  tier_id                           Int                                 @id
  tier_name                         String
  tier_description                  String?
  mentorship_collaboration_requests mentorship_collaboration_requests[]
  mentorship_collaborations         mentorship_collaborations[]
}

model coordinator_invites {
  invite_id  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email      String
  token      String
  created_at DateTime? @default(now()) @db.Timestamp(6)
  expires_at DateTime? @default(dbgenerated("(now() + '7 days'::interval)")) @db.Timestamp(6)
}

model documents {
  document_id   String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name          String?
  link          String?
  date_uploaded DateTime? @db.Date
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model evaluation_categories {
  evaluation_category_id       String                         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  evaluation_id                String                         @db.Uuid
  category_name                String
  rating                       Int?
  additional_comment           String?
  evaluations                  evaluations                    @relation(fields: [evaluation_id], references: [evaluation_id], onDelete: Cascade, onUpdate: NoAction)
  evaluation_selected_comments evaluation_selected_comments[]
}

model evaluation_selected_comments {
  selected_comment_id    String                @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  evaluation_category_id String                @db.Uuid
  comment                String
  evaluation_categories  evaluation_categories @relation(fields: [evaluation_category_id], references: [evaluation_category_id], onDelete: Cascade, onUpdate: NoAction)
}

model evaluations {
  evaluation_id         String                  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  mentor_id             String?                 @db.Uuid
  se_id                 String?                 @db.Uuid
  created_at            DateTime?               @db.Date
  isAcknowledge         Boolean?                @default(false)
  evaluation_type       evaluation_type_enum?
  evaluation_categories evaluation_categories[]
  mentors               mentors?                @relation(fields: [mentor_id], references: [mentor_id], onDelete: NoAction, onUpdate: NoAction, map: "mentor_id")
  socialenterprises     socialenterprises?      @relation(fields: [se_id], references: [se_id], onDelete: NoAction, onUpdate: NoAction, map: "se_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model expense {
  expense_id           String                 @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  expense_name         String                 @unique
  expense_amount       Decimal                @db.Decimal(12, 2)
  cash_out_transaction cash_out_transaction[]
}

model feedback {
  feedback_id       String       @id(map: "Feedback_pkey") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  mentorship_id     String?      @db.Uuid
  cmnt_id           String?      @db.Uuid
  rating            Int?
  isAckowledgedBySE Boolean?
  mentorships       mentorships? @relation(fields: [mentorship_id], references: [mentorship_id], onDelete: NoAction, onUpdate: NoAction, map: "mentorship_ID")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model inventory_report {
  inventory_id      String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  se_id             String            @db.Uuid
  month             DateTime          @db.Date
  item_id           String            @db.Uuid
  begin_qty         Decimal?          @db.Decimal(12, 2)
  begin_unit_price  Decimal?          @db.Decimal(12, 2)
  final_qty         Decimal?          @db.Decimal(12, 2)
  final_unit_price  Decimal?          @db.Decimal(12, 2)
  item              item              @relation(fields: [item_id], references: [item_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_item_inv_rep")
  socialenterprises socialenterprises @relation(fields: [se_id], references: [se_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_se_inv_rep")

  @@unique([se_id, month, item_id], map: "uq_inventory_per_item_per_month")
  @@index([item_id], map: "idx_inventory_report_item")
  @@index([se_id, month], map: "idx_inventory_report_se_month")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model item {
  item_id                  String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  item_name                String
  item_price               Decimal            @db.Decimal(12, 2)
  item_beginning_inventory Decimal            @default(0) @db.Decimal(12, 2)
  item_less_count          Decimal            @default(0) @db.Decimal(12, 2)
  bom_id                   String?            @db.Uuid
  inventory_report         inventory_report[]
  bom                      bom?               @relation(fields: [bom_id], references: [bom_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_bom_in_item")

  @@index([bom_id], map: "idx_item_bom_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model mentees_form_submissions {
